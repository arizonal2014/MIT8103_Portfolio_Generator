{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "type":"object","additionalProperties":false,
  "required":["version","rules","records","negativeTests","normalisationRoot"],
  "properties":{
    "version":{"const":1},
    "normalisationRoot":{"$ref":"#/definitions/identifier"},
    "rules":{"type":"array","maxItems":20,"items":{"oneOf":[
      {"type":"object","additionalProperties":false,"required":["ruleId","predicate"],"properties":{"ruleId":{"$ref":"#/definitions/identifier"},"predicate":{"$ref":"#/definitions/expression"}}},
      {"type":"object","additionalProperties":false,"required":["ruleId","predicate","keyFields"],"properties":{"ruleId":{"$ref":"#/definitions/identifier"},"predicate":{"$ref":"#/definitions/expression"},"keyFields":{"type":"array","minItems":1,"maxItems":8,"uniqueItems":true,"items":{"$ref":"#/definitions/identifier"}}}}
    ]}},
    "records":{"type":"array","minItems":2,"maxItems":8,"items":{"type":"object","additionalProperties":false,"required":["entity","rows"],"properties":{"entity":{"$ref":"#/definitions/identifier"},"rows":{"type":"array","minItems":1,"maxItems":8,"items":{"$ref":"#/definitions/row"}}}}},
    "negativeTests":{"type":"array","minItems":2,"maxItems":64,"items":{"type":"object","additionalProperties":false,"required":["id","entity","row","kind","target"],"properties":{"id":{"$ref":"#/definitions/identifier"},"entity":{"$ref":"#/definitions/identifier"},"row":{"$ref":"#/definitions/row"},"kind":{"enum":["primary_key","foreign_key","not_null","unique","check","partial_unique"]},"target":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,62}$"}}}}
  },
  "definitions":{
    "identifier":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,39}$"},
    "scalar":{"anyOf":[{"type":"string","maxLength":200},{"type":"number"},{"type":"boolean"},{"type":"null"}]},
    "row":{"type":"object","minProperties":2,"maxProperties":20,"additionalProperties":{"$ref":"#/definitions/scalar"}},
    "expression":{"oneOf":[
      {"type":"object","additionalProperties":false,"required":["op","args"],"properties":{"op":{"enum":["and","or"]},"args":{"type":"array","minItems":2,"maxItems":8,"items":{"$ref":"#/definitions/expression"}}}},
      {"type":"object","additionalProperties":false,"required":["op","field"],"properties":{"op":{"enum":["is_null","is_not_null"]},"field":{"$ref":"#/definitions/identifier"}}},
      {"type":"object","additionalProperties":false,"required":["op","field","value"],"properties":{"op":{"const":"eq"},"field":{"$ref":"#/definitions/identifier"},"value":{"type":"string","maxLength":100}}},
      {"type":"object","additionalProperties":false,"required":["op","left","right"],"properties":{"op":{"const":"gt_fields"},"left":{"$ref":"#/definitions/identifier"},"right":{"$ref":"#/definitions/identifier"}}},
      {"type":"object","additionalProperties":false,"required":["op","field","value"],"properties":{"op":{"enum":["gt_value","gte_value","lt_value","lte_value"]},"field":{"$ref":"#/definitions/identifier"},"value":{"type":"number","minimum":-1000000000,"maximum":1000000000}}}
    ]}
  }
}
